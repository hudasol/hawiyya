{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hawiyya FHIR R4 style Patient bundle (structure only)",
  "description": "The project's own structural schema for exported Patient bundles with Patient.link. It checks structure only and makes no claim of FHIR conformance.",
  "type": "object",
  "required": ["resourceType", "type", "meta", "entry"],
  "properties": {
    "resourceType": {"const": "Bundle"},
    "type": {"const": "collection"},
    "meta": {
      "type": "object",
      "required": ["tag"],
      "properties": {
        "tag": {
          "type": "array",
          "minItems": 1,
          "contains": {"type": "object", "properties": {"code": {"const": "synthetic"}}, "required": ["code"]}
        }
      }
    },
    "extension": {"type": "array"},
    "entry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["resource"],
        "properties": {
          "resource": {
            "type": "object",
            "required": ["resourceType", "id", "meta"],
            "properties": {
              "resourceType": {"const": "Patient"},
              "id": {"type": "string", "pattern": "^[A-Za-z0-9\\-.]{1,64}$"},
              "meta": {"type": "object", "required": ["tag"]},
              "active": {"type": "boolean"},
              "identifier": {
                "type": "array",
                "items": {"type": "object", "required": ["system", "value"],
                          "properties": {"system": {"type": "string", "pattern": "^urn:hawiyya:synthetic:"}, "value": {"type": "string"}}}
              },
              "name": {"type": "array", "items": {"type": "object", "required": ["text"]}},
              "gender": {"enum": ["male", "female", "unknown"]},
              "birthDate": {"type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"},
              "link": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["other", "type"],
                  "properties": {
                    "other": {"type": "object", "required": ["reference"],
                              "properties": {"reference": {"type": "string", "pattern": "^Patient/"}}},
                    "type": {"enum": ["replaced-by", "replaces", "refer", "seealso"]}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
