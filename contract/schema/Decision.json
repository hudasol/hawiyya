{
  "$defs": {
    "Costs": {
      "additionalProperties": false,
      "properties": {
        "c_fm": {
          "description": "Cost of a false merge",
          "exclusiveMinimum": 0,
          "title": "C Fm",
          "type": "number"
        },
        "c_md": {
          "description": "Cost of a missed duplicate",
          "exclusiveMinimum": 0,
          "title": "C Md",
          "type": "number"
        },
        "c_r": {
          "description": "Cost of a review",
          "exclusiveMinimum": 0,
          "title": "C R",
          "type": "number"
        }
      },
      "required": [
        "c_fm",
        "c_md",
        "c_r"
      ],
      "title": "Costs",
      "type": "object"
    },
    "DecisionKind": {
      "enum": [
        "LINK",
        "REVIEW",
        "KEEP_APART"
      ],
      "title": "DecisionKind",
      "type": "string"
    },
    "EvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "level": {
          "title": "Level",
          "type": "string"
        },
        "llr": {
          "description": "Log likelihood ratio, natural log, before frequency adjustment",
          "title": "Llr",
          "type": "number"
        },
        "m": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "M",
          "type": "number"
        },
        "placeholder": {
          "default": false,
          "title": "Placeholder",
          "type": "boolean"
        },
        "tf_adjustment": {
          "default": 0.0,
          "title": "Tf Adjustment",
          "type": "number"
        },
        "u": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "U",
          "type": "number"
        },
        "weight": {
          "description": "llr + tf_adjustment, the contribution to the log odds",
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "field",
        "level",
        "m",
        "u",
        "llr",
        "weight"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "EvidenceObject": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "description": "True when every field comparison was available",
          "title": "Complete",
          "type": "boolean"
        },
        "guards_fired": {
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "title": "Guards Fired",
          "type": "array"
        },
        "pair": {
          "$ref": "#/$defs/PairScore"
        }
      },
      "required": [
        "pair",
        "complete"
      ],
      "title": "EvidenceObject",
      "type": "object"
    },
    "PairScore": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          },
          "title": "Evidence",
          "type": "array"
        },
        "log_odds": {
          "title": "Log Odds",
          "type": "number"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "prior_log_odds": {
          "title": "Prior Log Odds",
          "type": "number"
        },
        "probability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Probability",
          "type": "number"
        },
        "probability_high": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Probability High",
          "type": "number"
        },
        "probability_low": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Probability Low",
          "type": "number"
        },
        "record_a": {
          "title": "Record A",
          "type": "string"
        },
        "record_b": {
          "title": "Record B",
          "type": "string"
        }
      },
      "required": [
        "record_a",
        "record_b",
        "prior_log_odds",
        "log_odds",
        "probability",
        "probability_low",
        "probability_high",
        "evidence",
        "model_version"
      ],
      "title": "PairScore",
      "type": "object"
    },
    "ReasonCode": {
      "enum": [
        "STRONG_ID_AGREEMENT",
        "STRONG_DEMOGRAPHIC_AGREEMENT",
        "INSUFFICIENT_EVIDENCE",
        "CONFLICTING_EVIDENCE",
        "PLACEHOLDER_ONLY",
        "COMMON_NAME_ONLY",
        "POSSIBLE_TWIN_OR_SIBLING",
        "POSSIBLE_PARENT_CHILD_SHARED_ID",
        "DOB_PLACEHOLDER_SUSPECTED",
        "CLUSTER_CONFLICT",
        "HARD_CONFLICT"
      ],
      "title": "ReasonCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "costs": {
      "$ref": "#/$defs/Costs"
    },
    "decision": {
      "$ref": "#/$defs/DecisionKind"
    },
    "evidence": {
      "$ref": "#/$defs/EvidenceObject"
    },
    "expected_costs": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Expected Costs",
      "type": "object"
    },
    "guards_fired": {
      "items": {
        "$ref": "#/$defs/ReasonCode"
      },
      "title": "Guards Fired",
      "type": "array"
    },
    "inputs_hash": {
      "title": "Inputs Hash",
      "type": "string"
    },
    "model_decision": {
      "$ref": "#/$defs/DecisionKind",
      "description": "Decision before guards"
    },
    "reason_codes": {
      "items": {
        "$ref": "#/$defs/ReasonCode"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "thresholds": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Thresholds",
      "type": "object"
    }
  },
  "required": [
    "decision",
    "model_decision",
    "reason_codes",
    "guards_fired",
    "evidence",
    "costs",
    "expected_costs",
    "thresholds",
    "inputs_hash"
  ],
  "title": "Decision",
  "type": "object"
}
